# Cloudinary configuration for server-side uploads (required for server-side signed uploads)
# If you want the backend to upload files to Cloudinary, set these three variables.
CLOUDINARY_CLOUD_NAME=dq7avew9h
CLOUDINARY_API_KEY=269445354174876
CLOUDINARY_API_SECRET=Qvl3ZGMLFCjKTXhbRX59Ot6fvTM
# Optional: if you prefer unsigned client uploads but still want the backend to suggest the endpoint,
# create an unsigned upload preset in your Cloudinary dashboard and set it here.
CLOUDINARY_UNSIGNED_UPLOAD_PRESET=your_unsigned_preset_name
# Optional folder to store uploads
CLOUDINARY_UPLOAD_FOLDER=paiements

# Other envs used by the backend
JWT_SECRET=change_me
APP_URL=http://localhost:3000

# Notes:
# - For quick testing without backend credentials, you can configure the frontend to perform unsigned
#   uploads directly to Cloudinary by setting the frontend env variables (in your frontend `.env`):
#     VITE_CLOUDINARY_UPLOAD_URL=https://api.cloudinary.com/v1_1/<your_cloud_name>/upload
#     VITE_CLOUDINARY_UPLOAD_PRESET=<your_unsigned_preset>
# - Signed uploads require the three server vars above. Restart the backend after setting envs.

# Précommandes NFC — n8n
# Le prix, le numéro Wave, le seuil du lot… sont dans la table nfc_settings (page admin « Précommandes NFC »).
# URL de production du webhook du workflow n8n WF1 (…/webhook/portefolia-nfc-preorder)
N8N_PREORDER_WEBHOOK_URL=
# Secret envoyé à n8n dans l'en-tête X-Portefolia-Key (openssl rand -hex 32)
N8N_WEBHOOK_KEY=
# Secret exigé quand n8n appelle /api/internal/* (en-tête X-Internal-Key) — différent du précédent
INTERNAL_API_KEY=
# Adresse du site utilisée dans les liens des e-mails (FRONTEND_BASE est utilisé à défaut)
FRONTEND_URL=
